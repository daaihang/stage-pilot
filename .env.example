STAGEPILOT_POSTGRES_DB=stagepilot
STAGEPILOT_POSTGRES_USER=stagepilot
STAGEPILOT_POSTGRES_PASSWORD=stagepilot
STAGEPILOT_POSTGRES_PORT=15432
STAGEPILOT_API_PORT=18080
STAGEPILOT_WORKER_INTERVAL=30s
AUTH_JWT_SECRET=change-this-in-production
AUTH_EXPOSE_DEV_TOKENS=false
INVITATION_CODE_HASH_KEY=change-this-in-production
INVITATION_CODE_ENCRYPTION_KEY=change-this-in-production

# S3-compatible object storage (defaults target local MinIO)
S3_ENDPOINT=http://localhost:19000
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=stagepilot
S3_ACCESS_KEY=stagepilot
S3_SECRET_KEY=stagepilot-secret
S3_USE_SSL=false
S3_PATH_STYLE=true
S3_UPLOAD_URL_TTL=15m
FILES_MAX_BYTES=5368709120
