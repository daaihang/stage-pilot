{
  "name": "stagepilot-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "desktop:dev": "pnpm --filter @stagepilot/desktop dev",
    "desktop:build": "pnpm --filter @stagepilot/desktop build",
    "desktop:tauri:dev": "pnpm --filter @stagepilot/desktop tauri:dev",
    "desktop:tauri:build": "pnpm --filter @stagepilot/desktop tauri:build",
    "backend:dev": "pnpm --filter @stagepilot/backend-api dev",
    "docker:up": "docker compose -f docker/compose.yaml up -d --build",
    "docker:down": "docker compose -f docker/compose.yaml down"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
