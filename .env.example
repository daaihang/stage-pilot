STAGEPILOT_POSTGRES_DB=stagepilot
STAGEPILOT_POSTGRES_USER=stagepilot
STAGEPILOT_POSTGRES_PASSWORD=stagepilot
STAGEPILOT_POSTGRES_PORT=15432
STAGEPILOT_API_PORT=18080
STAGEPILOT_WORKER_INTERVAL=30s
AUTH_JWT_SECRET=change-this-in-production
AUTH_EXPOSE_DEV_TOKENS=false
INVITATION_CODE_HASH_KEY=stagepilot-development-invitation-hash-key-change-me-32bytes
INVITATION_CODE_ENCRYPTION_KEY=stagepilot-development-invitation-encryption-key-change-me-32bytes

# S3-compatible object storage (defaults target local MinIO)
S3_ENDPOINT=http://localhost:19000
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=stagepilot
S3_ACCESS_KEY=stagepilot
S3_SECRET_KEY=stagepilot-secret
S3_USE_SSL=false
S3_PATH_STYLE=true
S3_UPLOAD_URL_TTL=15m
FILES_MAX_BYTES=2000000000
FILES_WORKSPACE_PHYSICAL_MAX_BYTES=100000000000

# Secondary S3-compatible disaster-recovery store (local Compose uses test MinIO)
S3_REPLICA_ENDPOINT=http://minio-replica:9000
S3_REPLICA_REGION=us-east-1
S3_REPLICA_BUCKET=stagepilot-file-replica
S3_REPLICA_BACKUP_BUCKET=stagepilot-pg-backup
S3_REPLICA_ACCESS_KEY=stagepilot-replica
S3_REPLICA_SECRET_KEY=stagepilot-replica-secret
S3_REPLICA_USE_SSL=false
S3_REPLICA_REQUIRED=true
BACKUP_INTERVAL_SECONDS=86400
BASE_BACKUP_RETRY_SECONDS=300
WAL_WATERMARK_INTERVAL_SECONDS=300
MINIO_AUDIT_WEBHOOK_AUTH_TOKEN=replace-with-a-long-random-token
