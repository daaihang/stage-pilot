{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "globalEnv": ["NODE_ENV", "GOCACHE", "GOPATH", "LOCALAPPDATA", "TEMP", "TMP"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "bin/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
